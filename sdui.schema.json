{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://pxds.local/sdui.schema.json",
	"title": "PXDS SDUI screen spec",
	"description": "Root schema for app screen SDUI files. Supports the compact canonical slots contract and the deprecated renderable screen contract during migration.",
	"oneOf": [
		{ "$ref": "#/$defs/canonicalScreen" },
		{ "$ref": "#/$defs/legacyRenderableScreen" }
	],
	"$defs": {
		"schemaRef": {
			"type": "string",
			"pattern": "(^|/)sdui\\.schema\\.json$"
		},
		"jsonValue": {
			"oneOf": [
				{ "type": "null" },
				{ "type": "boolean" },
				{ "type": "number" },
				{ "type": "string" },
				{
					"type": "array",
					"items": { "$ref": "#/$defs/jsonValue" }
				},
				{
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				}
			]
		},
		"canonicalNode": {
			"type": "object",
			"required": ["component"],
			"properties": {
				"component": { "type": "string", "minLength": 1 },
				"section": { "$ref": "#/$defs/canonicalSection" },
				"props": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"children": {
					"type": "array",
					"items": { "$ref": "#/$defs/canonicalNode" }
				}
			},
			"additionalProperties": false
		},
		"canonicalSection": {
			"type": "object",
			"properties": {
				"inset": { "enum": ["inherit", "bleed"] },
				"rail": { "enum": ["none", "inset", "measure", "full"] },
				"measure": { "enum": ["caption", "body", "title"] }
			},
			"additionalProperties": false
		},
		"canonicalSlots": {
			"type": "object",
			"required": ["system_header", "header", "content", "bottom"],
			"properties": {
				"system_header": { "type": "boolean" },
				"header": {
					"oneOf": [
						{ "$ref": "#/$defs/canonicalNode" },
						{ "const": false }
					]
				},
				"content": {
					"type": "array",
					"items": { "$ref": "#/$defs/canonicalNode" }
				},
				"bottom": {
					"oneOf": [
						{
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/canonicalNode" }
						},
						{ "const": false }
					]
				}
			},
			"additionalProperties": false
		},
		"canonicalScreen": {
			"type": "object",
			"required": ["$schema", "schemaVersion", "screen_id", "shell", "slots"],
			"properties": {
				"$schema": { "$ref": "#/$defs/schemaRef" },
				"schemaVersion": { "const": "sdui-v1" },
				"screen_id": { "type": "string", "minLength": 1 },
				"shell": { "const": "app-screen" },
				"metadata": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"data": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"slots": { "$ref": "#/$defs/canonicalSlots" }
			},
			"additionalProperties": false
		},
		"legacyNode": {
			"type": "object",
			"required": ["type", "id"],
			"properties": {
				"type": { "type": "string", "minLength": 1 },
				"id": { "type": "string", "minLength": 1 },
				"componentVersion": { "type": "string" },
				"props": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"children": {
					"type": "array",
					"items": { "$ref": "#/$defs/legacyNode" }
				}
			},
			"additionalProperties": true
		},
		"legacyMetadata": {
			"type": "object",
			"required": ["id", "name", "route", "domain", "type", "status"],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"name": { "type": "string", "minLength": 1 },
				"route": { "type": "string", "pattern": "^/" },
				"domain": { "type": "string", "minLength": 1 },
				"type": { "enum": ["page", "bottom-sheet"] },
				"status": { "type": "string", "minLength": 1 }
			},
			"additionalProperties": true
		},
		"legacyRenderableScreen": {
			"type": "object",
			"required": ["$schema", "version", "metadata", "children"],
			"properties": {
				"$schema": { "$ref": "#/$defs/schemaRef" },
				"version": { "type": "string", "minLength": 1 },
				"minRendererVersion": { "type": "string" },
				"minComponentsVersion": { "type": "string" },
				"metadata": { "$ref": "#/$defs/legacyMetadata" },
				"theme": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"data": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/jsonValue" }
				},
				"children": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/legacyNode" }
				}
			},
			"additionalProperties": true
		}
	}
}
