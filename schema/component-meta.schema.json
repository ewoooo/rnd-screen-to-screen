{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screen-to-screen.local/schema/component-meta.schema.json",
  "title": "Component Meta",
  "description": "JSON-safe ownership metadata for one component folder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "layer",
    "owner",
    "importPath",
    "group",
    "status",
    "createdAt"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": ["core", "atom", "molecule", "organism", "template"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "importPath": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "experimental", "deprecated"]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "exportMode": {
      "type": "string",
      "enum": ["instance", "render-tree"]
    },
    "sourceRefs": {
      "$ref": "#/$defs/stringList"
    },
    "specRefs": {
      "$ref": "#/$defs/stringList"
    },
    "policyRefs": {
      "$ref": "#/$defs/stringList"
    },
    "composedOf": {
      "$ref": "#/$defs/stringList"
    },
    "sbAliases": {
      "$ref": "#/$defs/stringList"
    },
    "tags": {
      "$ref": "#/$defs/stringList"
    },
    "policySlots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
