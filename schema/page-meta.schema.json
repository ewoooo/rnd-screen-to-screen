{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screen-to-screen.local/schema/page-meta.schema.json",
  "title": "Page Meta",
  "description": "JSON-safe ownership metadata for one mobile page folder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "route",
    "type",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "pattern": "^/.+"
    },
    "type": {
      "type": "string",
      "enum": ["page", "bottom-sheet"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "experimental", "deprecated"]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRefs": {
      "$ref": "#/$defs/stringList"
    },
    "specRefs": {
      "$ref": "#/$defs/stringList"
    },
    "policyRefs": {
      "$ref": "#/$defs/stringList"
    },
    "useCaseIds": {
      "$ref": "#/$defs/stringList"
    },
    "ognSpecIds": {
      "$ref": "#/$defs/stringList"
    },
    "tags": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
