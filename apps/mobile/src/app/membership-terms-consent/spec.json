{
  "meta": {
    "schema_version": 2,
    "status": "active",
    "route": "/membership-terms-consent",
    "source": "implemented-page"
  },
  "screen": {
    "id": "membership-terms-consent",
    "name": "약관 동의",
    "domain": "membership",
    "type": "page"
  },
  "x_interfacePlan": {
    "genre": "selector",
    "primary_task": "필수 약관 동의 + 선택 약관 결정",
    "info_hierarchy": [
      "hero",
      "required-input (약관 그룹 카드 — title only)",
      "conditional-notice (미성년 안내)",
      "action"
    ],
    "cta_location": "bottom-sticky",
    "progress_location": "top-bar-thin",
    "sectioning": "one-card",
    "copy_policy": {
      "description_measure": "body",
      "avoid_full_width_caption": true
    },
    "rail_policy": {
      "owner": "ContentRail",
      "route_margin": "forbidden",
      "bleed_restore": "ContentRail rail=inset"
    },
    "spacing_policy": {
      "hero_to_input": "MembershipHero pb=section; ContentList gap remains spacing-4"
    }
  },
  "screen_contract": {
    "shell": "AppScreen",
    "slots": {
      "top": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipTopBar"
        ],
        "flow": "reserved"
      },
      "content": {
        "owner": "ContentList",
        "patterns": [
          "MembershipHero",
          "TermsAgreementGroup",
          "MembershipNotice"
        ]
      },
      "bottom": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipContinueBar"
        ],
        "flow": "reserved"
      }
    }
  },
  "layout_contract": {
    "content_outlet_inline_inset": "spacing-12",
    "section_inset": "inherit",
    "content_gap": "spacing-4",
    "content_gap_owner": "ContentList",
    "top_bottom_flow": "reserved",
    "bleed_sections": [],
    "content_rail_owner": "ContentRail"
  },
  "areas": [
    {
      "id": "top-progress",
      "slot": "top",
      "pattern": "organisms/membership/MembershipTopBar",
      "uses": [
        "StatusBar",
        "TopNavigation",
        "ProgressIndicator"
      ],
      "layout": {
        "flow": "reserved",
        "progress_source": "data.hero.eyebrow"
      },
      "content_role": "flow-progress"
    },
    {
      "id": "hero",
      "slot": "content",
      "pattern": "organisms/membership/MembershipHero",
      "uses": [
        "ContentSection",
        "TextBlock",
        "ContentRail"
      ],
      "layout": {
        "section_inset": "inherit",
        "description_rail": "measure:body",
        "block_padding_top": "spacing-16",
        "block_padding_bottom": "spacing-32",
        "after_spacing_owner": "MembershipHero"
      },
      "content_role": "primary-copy"
    },
    {
      "id": "terms",
      "slot": "content",
      "pattern": "organisms/membership/TermsAgreementGroup",
      "uses": [
        "ContentSection",
        "SectionCard",
        "ConsentList",
        "TextBlock"
      ],
      "layout": {
        "section_inset": "inherit",
        "card_label_omitted": true,
        "card_title_only": true
      },
      "content_role": "required-input"
    },
    {
      "id": "guardian-notice",
      "slot": "content",
      "pattern": "organisms/membership/MembershipNotice",
      "uses": [
        "ContentSection",
        "NoticeBlock",
        "TextBlock"
      ],
      "layout": {
        "section_inset": "inherit"
      },
      "content_role": "conditional-notice"
    },
    {
      "id": "continue",
      "slot": "bottom",
      "pattern": "organisms/membership/MembershipContinueBar",
      "uses": [
        "Box",
        "Button",
        "TextBlock"
      ],
      "content_role": "primary-action",
      "layout": {
        "surface": "page-semi-gradient"
      },
      "state_binding": {
        "primary_disabled_when": "terms.missingRequiredCount > 0",
        "eyebrow_when_blocked": "필수 약관 N개 동의가 남았어요",
        "eyebrow_when_ready": "data.continue.eyebrow"
      }
    }
  ],
  "design_system_contract": {
    "templates": [
      "AppScreen",
      "AppScreenContent",
      "ContentOutlet",
      "ContentList",
      "ContentSection",
      "ContentRail"
    ],
    "organisms": [
      "membership"
    ],
    "molecules": [
      "ConsentList",
      "NoticeBlock",
      "SectionCard",
      "ProgressIndicator"
    ],
    "atoms": [
      "TextBlock"
    ],
    "allowed_escape_hatches": [
      {
        "location": "molecules/consent-list/ConsentList.tsx",
        "kind": "raw-min-height",
        "value": "minHeight: 60 / 64",
        "reason": "터치 타깃 보장 (WDS ListCell verticalPadding=medium 대응)",
        "owner": "molecule"
      }
    ],
    "new_vocabulary_required": [
      "organisms/membership"
    ]
  }
}
