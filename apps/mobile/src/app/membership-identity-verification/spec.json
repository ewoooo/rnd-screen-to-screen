{
  "meta": {
    "schema_version": 2,
    "status": "active",
    "route": "/membership-identity-verification",
    "source": "implemented-page"
  },
  "screen": {
    "id": "membership-identity-verification",
    "name": "본인인증",
    "domain": "membership",
    "type": "page"
  },
  "x_interfacePlan": {
    "genre": "selector",
    "primary_task": "본인인증 수단 1개 선택 후 외부 인증으로 이동",
    "info_hierarchy": [
      "hero",
      "required-input (인증 수단 SelectableList comfortable + leading icon + trailing chip)",
      "supporting-notice (재시도/잠금 정책)",
      "action (인증하기)"
    ],
    "cta_location": "bottom-sticky",
    "progress_location": "top-bar-thin",
    "sectioning": "flat",
    "copy_policy": {
      "description_measure": "body"
    },
    "rail_policy": {
      "description": "measure:body",
      "notice": "measure:body"
    }
  },
  "screen_contract": {
    "shell": "AppScreen",
    "slots": {
      "top": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipTopBar"
        ],
        "flow": "reserved"
      },
      "content": {
        "owner": "ContentList",
        "patterns": [
          "MembershipHero",
          "SelectableList",
          "MembershipNotice"
        ]
      },
      "bottom": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipContinueBar"
        ],
        "flow": "reserved"
      }
    }
  },
  "layout_contract": {
    "content_outlet_inline_inset": "spacing-12",
    "section_inset": "inherit",
    "content_gap": "spacing-4",
    "content_gap_owner": "ContentList",
    "top_bottom_flow": "reserved",
    "bleed_sections": [],
    "content_rail_owner": "ContentRail"
  },
  "areas": [
    {
      "id": "hero",
      "slot": "content",
      "pattern": "organisms/membership/MembershipHero",
      "uses": [
        "ContentSection",
        "TextBlock",
        "ContentRail"
      ],
      "layout": {
        "section_inset": "inherit",
        "description_rail": "measure:body"
      },
      "content_role": "primary-copy"
    },
    {
      "id": "methods",
      "slot": "content",
      "pattern": "molecules/SelectableList (inline)",
      "uses": [
        "ContentSection",
        "SelectableList"
      ],
      "layout": {
        "section_inset": "inherit",
        "selectable_density": "comfortable",
        "selectable_leading": "icon",
        "selectable_trailing": "chip",
        "trailing_semantic": "recommendation"
      },
      "content_role": "required-input"
    },
    {
      "id": "policy-notice",
      "slot": "content",
      "pattern": "organisms/membership/MembershipNotice",
      "uses": [
        "ContentSection",
        "NoticeBlock",
        "TextBlock",
        "ContentRail"
      ],
      "layout": {
        "section_inset": "inherit",
        "text_rail": "measure:body"
      },
      "content_role": "supporting-notice"
    },
    {
      "id": "continue",
      "slot": "bottom",
      "pattern": "organisms/membership/MembershipContinueBar",
      "uses": [
        "Box",
        "Button",
        "TextBlock"
      ],
      "content_role": "primary-action",
      "layout": {
        "surface": "page-semi-gradient"
      },
      "state_binding": {
        "primary_disabled_when": "method 미선택",
        "eyebrow_when_blocked": "인증 수단을 선택해주세요",
        "eyebrow_when_ready": "data.continue.eyebrow"
      }
    }
  ],
  "design_system_contract": {
    "templates": [
      "AppScreen",
      "AppScreenContent",
      "ContentOutlet",
      "ContentList",
      "ContentSection",
      "ContentRail"
    ],
    "organisms": [
      "membership"
    ],
    "molecules": [
      "SelectableList",
      "NoticeBlock"
    ],
    "atoms": [
      "TextBlock"
    ],
    "allowed_escape_hatches": [],
    "new_vocabulary_required": [
      "SelectableItem.leading prop (large-icon ListCellContent)"
    ]
  }
}
