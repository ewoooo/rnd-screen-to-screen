{
  "meta": {
    "schema_version": 2,
    "status": "active",
    "route": "/membership-personal-info",
    "source": "implemented-page"
  },
  "screen": {
    "id": "membership-personal-info",
    "name": "개인정보 입력",
    "domain": "membership",
    "type": "page"
  },
  "x_interfacePlan": {
    "genre": "form",
    "primary_task": "회원 가입에 필요한 기본 정보 입력 + 형식 검증",
    "info_hierarchy": [
      "hero (단계 맥락)",
      "required-input (이름·생년월일·성별·휴대전화)",
      "action (다음으로)"
    ],
    "cta_location": "bottom-sticky",
    "progress_location": "top-bar-thin",
    "sectioning": "flat",
    "copy_policy": {
      "description_measure": "body",
      "avoid_full_width_caption": true
    },
    "rail_policy": {
      "owner": "ContentRail",
      "form_fields": "measure:body",
      "description": "measure:body"
    }
  },
  "screen_contract": {
    "shell": "AppScreen",
    "slots": {
      "top": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipTopBar"
        ],
        "flow": "reserved"
      },
      "content": {
        "owner": "ContentList",
        "patterns": [
          "MembershipHero",
          "MembershipPersonalInfoForm"
        ]
      },
      "bottom": {
        "owner": "MembershipShell",
        "patterns": [
          "MembershipContinueBar"
        ],
        "flow": "reserved"
      }
    }
  },
  "layout_contract": {
    "content_outlet_inline_inset": "spacing-12",
    "section_inset": "inherit",
    "content_gap": "spacing-4",
    "content_gap_owner": "ContentList",
    "top_bottom_flow": "reserved",
    "bleed_sections": [],
    "content_rail_owner": "ContentRail"
  },
  "areas": [
    {
      "id": "hero",
      "slot": "content",
      "pattern": "organisms/membership/MembershipHero",
      "uses": [
        "ContentSection",
        "TextBlock",
        "ContentRail"
      ],
      "layout": {
        "section_inset": "inherit",
        "description_rail": "measure:body"
      },
      "content_role": "primary-copy"
    },
    {
      "id": "form",
      "slot": "content",
      "pattern": "organisms/membership/MembershipPersonalInfoForm",
      "uses": [
        "ContentSection",
        "ContentRail",
        "FormField",
        "TextField",
        "SelectableList"
      ],
      "layout": {
        "section_inset": "inherit",
        "sectioning": "flat",
        "form_rail": "measure:body"
      },
      "content_role": "required-input"
    },
    {
      "id": "continue",
      "slot": "bottom",
      "pattern": "organisms/membership/MembershipContinueBar",
      "uses": [
        "Box",
        "Button",
        "TextBlock"
      ],
      "content_role": "primary-action",
      "layout": {
        "surface": "page-semi-gradient"
      },
      "state_binding": {
        "primary_disabled_when": "필수 필드 비어있거나 형식 오류 1건 이상",
        "eyebrow_when_blocked": "남은 필수 항목을 입력해주세요",
        "eyebrow_when_ready": "data.continue.eyebrow",
        "error_message_owner": "FormField.errorText (CTA 위 중복 금지)"
      }
    }
  ],
  "design_system_contract": {
    "templates": [
      "AppScreen",
      "AppScreenContent",
      "ContentOutlet",
      "ContentList",
      "ContentSection",
      "ContentRail"
    ],
    "organisms": [
      "membership"
    ],
    "molecules": [
      "FormField",
      "TextField",
      "SelectableList"
    ],
    "atoms": [
      "TextBlock"
    ],
    "allowed_escape_hatches": [
      {
        "location": "molecules/form-field/FormField.tsx",
        "kind": "raw-margin",
        "value": "marginLeft: var(--spacing-2)",
        "reason": "required * mark과 label 사이 미세 간격. 본 화면 사용 중",
        "owner": "molecule"
      }
    ],
    "new_vocabulary_required": [
      "organisms/membership/MembershipPersonalInfoForm"
    ]
  }
}
