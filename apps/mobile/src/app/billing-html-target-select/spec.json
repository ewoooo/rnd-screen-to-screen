          "SummaryCard",
          "NoticeBlock"
        ]
      },
      "bottom": {
        "owner": "PrimaryCTABar",
        "patterns": [
          "PrimaryCTABar"
        ],
        "flow": "reserved"
      }
    }
  },
  "layout_contract": {
    "content_outlet_inline_inset": "spacing-12",
    "section_inset": "inherit",
    "content_gap": "spacing-4",
