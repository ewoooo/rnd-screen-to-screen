    "top_bottom_flow": "reserved",
    "bleed_sections": [],
    "content_rail_owner": "ContentRail"
  },
  "areas": [
    {
      "id": "top",
      "slot": "top",
      "pattern": "organisms/global/GlobalNavigationHeader",
      "uses": [
        "GlobalNavigationHeader"
      ],
      "layout": {
        "leading": "back",
        "title": "납부 대상 선택"
      },
      "content_role": "chrome"
    },
    {
      "id": "targets",
      "slot": "content",
      "pattern": "molecules/SelectableList",
      "uses": [
        "SelectableList",
        "Checkbox"
      ],
      "layout": {
        "selectionMode": "multi"
      },
      "content_role": "selectable",
      "state_binding": {
        "exclude_when": "POL-BIL-PAY-001-02 제외 항목"
      }
    },
    {
      "id": "total",
      "slot": "content",
      "pattern": "molecules/SummaryCard",
      "uses": [
        "SummaryCard"
      ],
      "content_role": "selection-summary"
    },
    {
      "id": "limit-notice",
      "slot": "content",
      "pattern": "molecules/NoticeBlock",
      "uses": [
        "NoticeBlock"
      ],
      "content_role": "supporting-notice",
      "state_binding": {
        "visible_when": "납부 가능 시간 제한 OR 부분 납부 제한"
      }
    },
    {
      "id": "cta",
      "slot": "bottom",
      "pattern": "molecules/PrimaryCTABar",
      "uses": [
        "PrimaryCTABar",
        "Button"
      ],
      "content_role": "primary-action",
      "state_binding": {
        "primary_disabled_when": "selected_count == 0 OR total == 0"
      }
    }
  ],
  "design_system_contract": {
