{
  "meta": {
    "schema_version": 2,
    "status": "experimental-html",
    "route": "/billing-html-pay-confirm",
    "source": "policy-driven",
    "policy_doc": "docs/정책서-Full-청구관리및요금수납_정책서.html",
    "policy_section": "4. US-BIL-PAY-002 / PR-BIL-PAY-002-01",
    "pagination_ref": "apps/mobile/src/screens/spec-source/experimental/billing-from-html/_pagination/billing-html-pay.json"
  },
  "screen": {
    "id": "billing-html-pay-confirm",
    "name": "즉시 납부 확인",
    "domain": "billing-html",
    "use_case": "US-BIL-PAY-002",
    "process_id": "PR-BIL-PAY-002-01",
    "step_fraction": "2/8",
    "type": "page"
  },
  "x_interfacePlan": {
    "genre": "form",
    "primary_task": "납부 정보 최종 확인 + 승인 요청",
    "info_hierarchy": [
      "hero",
      "summary (대상·금액)",
      "method-info (마스킹)",
      "action (결제 확인)"
    ],
    "cta_location": "bottom-sticky",
    "progress_location": "top-bar-thin",
    "sectioning": "one-card",
    "copy_policy": {
      "description_measure": "body",
      "avoid_full_width_caption": true
    },
    "rail_policy": {
      "owner": "ContentRail",
      "route_margin": "forbidden"
    }
  },
  "screen_contract": {
    "shell": "AppScreen",
    "slots": {
      "top": {
        "owner": "GlobalNavigationHeader",
        "patterns": [
          "GlobalNavigationHeader"
        ],
        "flow": "reserved"
      },
      "content": {
        "owner": "ContentList",
        "patterns": [
          "ContentSection",
          "TextBlock",
          "SummaryCard",
          "InfoList"
        ]
      },
      "bottom": {
        "owner": "StickyActionBar",
        "patterns": [
          "StickyActionBar"
        ],
        "flow": "reserved"
      }
    }
  },
  "layout_contract": {
    "content_outlet_inline_inset": "spacing-12",
    "section_inset": "inherit",
    "content_gap": "spacing-4",
    "content_gap_owner": "ContentList",
    "top_bottom_flow": "reserved",
    "bleed_sections": [],
    "content_rail_owner": "ContentRail"
  },
  "areas": [
    {
      "id": "top-progress",
      "slot": "top",
      "pattern": "organisms/global/GlobalNavigationHeader",
      "uses": [
        "TopNavigation",
        "ProgressIndicator"
      ],
      "layout": {
        "flow": "reserved",
        "leading": "back"
      },
      "content_role": "flow-progress"
    },
    {
      "id": "hero",
      "slot": "content",
      "pattern": "ContentSection + TextBlock",
      "uses": [
        "ContentSection",
        "ContentRail",
        "TextBlock"
      ],
      "content_role": "primary-copy"
    },
    {
      "id": "summary",
      "slot": "content",
      "pattern": "molecules/SummaryCard",
      "uses": [
        "ContentSection",
        "SummaryCard"
      ],
      "content_role": "review-summary"
    },
    {
      "id": "info",
      "slot": "content",
      "pattern": "molecules/InfoList",
      "uses": [
        "ContentSection",
        "InfoList",
        "TextBlock"
      ],
      "layout": {
        "section_inset": "inherit",
        "trailing_semantic": "value"
      },
      "content_role": "method-info"
    },
    {
      "id": "continue",
      "slot": "bottom",
      "pattern": "molecules/StickyActionBar",
      "uses": [
        "Box",
        "Button",
        "TextBlock"
      ],
      "content_role": "primary-action",
      "state_binding": {
        "primary_disabled_when": "submission.inflight == true"
      }
    }
  ],
  "design_system_contract": {
    "templates": [
      "AppScreen",
      "ContentList",
      "ContentSection",
      "ContentRail"
    ],
    "organisms": [
      "global"
    ],
    "molecules": [
      "SummaryCard",
      "InfoList",
      "StickyActionBar"
    ],
    "atoms": [
      "TextBlock"
    ],
    "allowed_escape_hatches": [],
    "new_vocabulary_required": []
  }
}
