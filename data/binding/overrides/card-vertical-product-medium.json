{
	"meta": {
		"purpose": "Figma card-vertical-product/medium → WDS Card 매핑",
		"figma_source": "data/design/components/card-vertical-product-medium.json",
		"wds_source": "registry/wds-component-registry.json",
		"fetched_at": "2026-04-24",
		"strategy": "WDS Card(flexDirection=column) + ImgRectanglePilot(size=large) + CardContent. slot-badge는 children/Chip이 아닌 div+Typography (WDS BadgeSlot 미존재). 색은 semantic 토큰 우선, card/promotion은 violet accent로 위임."
	},
	"mapping": {
		"target_component": "card",
		"target_import": "import { Card, CardCaption, CardContent, CardTitle, Typography } from '@wanteddev/wds';",
		"root": {
			"wds": "Card",
			"props": { "platform": "mobile", "flexDirection": "column", "gap": 20, "width": 228, "sx": { "padding": "20px 20px 50px", "borderRadius": 32 } },
			"from_figma": { "node": "1:26922", "size": "228×369" }
		},
		"thumbnail": {
			"wds": "ImgRectanglePilot",
			"props": { "size": "large" },
			"from_figma": { "node": "1:26923", "size": "188×188", "radius": 20 }
		},
		"info_block": {
			"wds": "CardContent",
			"props": { "flexDirection": "column", "gap": 10, "sx": { "width": "100%" } },
			"children": [
				{ "wds": "CardCaption", "variant": "caption1", "weight": "medium", "from_figma": "brand (12/14 Medium)" },
				{ "wds": "CardTitle", "variant": "body1", "weight": "bold", "maxLines": 1, "from_figma": "title (16/20 Bold)" },
				{ "wds": "Typography composite", "from_figma": "price-block", "spans": ["info (violet 14 bold)", "price (14 bold)", "month (12 bold)"] },
				{ "wds": "div + Typography", "role": "slot-badge", "from_figma": "slot-badge (#ffeaea + #d54949)", "conditional": "showSlot" }
			]
		}
	},
	"token_overrides": {
		"mappings": [
			{ "from_figma": "card/promotion #3014b8", "to_wds": "var(--semantic-text-accent-violet)", "confidence": "medium" },
			{ "from_figma": "card/slot/onslot", "to_wds": "fixed #ffeaea / #d54949", "confidence": "low", "note": "WDS semantic-* 토큰 매칭 부재. 추후 wds-token-registry 검색 필요" }
		]
	},
	"open_questions": [
		"slot-badge에 들어가는 정식 BadgeSlot 컴포넌트가 WDS에 있는지",
		"radius=32(card/radius-vertical)에 대응하는 semantic radius 토큰"
	]
}
