{
	"meta": {
		"purpose": "Figma header (C1) → WDS TopNavigation 오버라이드 파일럿",
		"figma_source": "data/design/components/header.json + data/design/layouts/header.json",
		"wds_source": "registry/wds-component-registry.json + registry/wds-token-registry.json + registry/wds-icon-registry.json",
		"notion_code": "C1",
		"fetched_at": "2026-04-24",
		"strategy": "Figma는 구조/레이아웃만 참조. 색·간격·타이포는 WDS semantic 토큰으로 대체."
	},
	"mapping": {
		"target_component": "top-navigation",
		"target_import": "import { TopNavigation, TopNavigationButton } from '@wanteddev/wds';",
		"target_package": "@wanteddev/wds",
		"root": {
			"wds": "TopNavigation",
			"props": {
				"variant": "floating",
				"background": true,
				"comment": "Figma의 gradient(white→rgba(246,246,246,0.8)) + backdrop-blur(20) 효과는 variant='floating'이 내장 처리"
			},
			"from_figma": { "node": "1:26091", "layout": "HORIZONTAL SPACE_BETWEEN padding=18 gap=192 sizing=FIXED/FIXED" },
			"from_figma_drop": ["background_gradient", "backdrop_blur_20", "padding_18"],
			"drop_reason": "WDS TopNavigation이 자체 레이아웃·배경 관리. 컨슈머는 variant만 지정"
		},
		"leading_content": {
			"wds": "prop: leadingContent",
			"render": null,
			"from_figma": { "node": "1:26092", "note": "빈 슬롯 (28×28). 현재 디자인엔 로고/뒤로가기 미노출)" },
			"conditional": "btn-header-back(1:26093)이 hidden=true 이므로 생략"
		},
		"trailing_content": {
			"wds": "prop: trailingContent",
			"render": [
				{
					"wds": "TopNavigationButton",
					"props": { "variant": "icon", "color": "assistive", "size": "medium" },
					"children": { "wds_icon": "IconSearch", "size": 24 },
					"from_figma": { "node": "1:26096", "icon_ref": "ico/search (1:27401)" }
				},
				{
					"wds": "TopNavigationButton",
					"props": { "variant": "icon", "color": "assistive", "size": "medium" },
					"children": [
						{
							"wds_icon": "IconBusinessBag",
							"size": 24,
							"fallback_note": "WDS에 명시적 cart 아이콘 없음. IconBusinessBag이 최근접. 대안: Figma 원본 asset 유지 or 커스텀 아이콘 등록"
						},
						{
							"wds": "PushBadge",
							"props": { "count": "N" },
							"from_figma": { "node": "I1:26097;1:26100 badge-label-text", "tokens_drop": ["#3014b8"], "replace_with": "PushBadge 기본 스타일" }
						}
					],
					"from_figma": { "node": "1:26097 button-icon + badge" }
				}
			],
			"trailing_layout_from_figma": { "gap": 12, "align": "MAX/CENTER", "sizing": "HUG/FIXED" },
			"trailing_layout_in_wds": "TopNavigation이 trailingContent 내부 정렬 자동 처리"
		}
	},
	"token_overrides": {
		"strategy": "Figma 토큰 → WDS semantic (없으면 atomic + 사유 기록)",
		"mappings": [
			{
				"from_figma": "header background linear-gradient(#ffffff → rgba(246,246,246,0.8))",
				"to_wds": "variant='floating' 내부에서 background.elevated.normal + material.dimmer 처리",
				"css_var": "var(--semantic-background-elevated-normal) / var(--semantic-material-dimmer)",
				"confidence": "high"
			},
			{
				"from_figma": "padding 18px",
				"to_wds": "WDS TopNavigation 내장 패딩 사용",
				"spacing_token": "NA (컴포넌트 내장)",
				"confidence": "high"
			},
			{
				"from_figma": "gap 12px (trailing)",
				"to_wds": "spacing.12",
				"css_var": "var(--spacing-12)",
				"confidence": "high"
			},
			{
				"from_figma": "badge bg #3014b8 (purple)",
				"to_wds": "PushBadge 기본 색 (semantic.primary.normal = #0066FF)",
				"css_var": "var(--semantic-primary-normal)",
				"confidence": "low",
				"visual_diff": "보라(#3014b8) → 파랑(#0066FF). 브랜드 컬러 오버라이드 필요 시 primary 토큰 재정의 또는 atomic.purple 직접 사용"
			},
			{
				"from_figma": "badge text #ffffff",
				"to_wds": "semantic.static.white",
				"css_var": "var(--semantic-static-white)",
				"confidence": "high"
			},
			{
				"from_figma": "ico 24×24",
				"to_wds": "WDS Icon size=24 (TopNavigationButton size=medium 내부값)",
				"confidence": "high"
			}
		]
	},
	"layout_invariants_from_figma": {
		"keep": [
			{ "field": "root.sizing", "value": "FIXED/FIXED 360×64", "reason": "TopNavigation 기본 높이와 동일" },
			{ "field": "root.layout.primary_align", "value": "SPACE_BETWEEN", "reason": "leading/trailing 양 끝 배치" },
			{ "field": "trailing.layout.gap", "value": 12, "reason": "WDS에 해당 spacing 토큰 존재" },
			{ "field": "icon.size", "value": 24, "reason": "WDS medium variant와 일치" },
			{ "field": "badge.constraints", "value": "MAX/MIN (우측상단)", "reason": "PushBadge 기본 위치와 일치" }
		]
	},
	"text_behavior_from_figma": {
		"note": "header는 텍스트 슬롯 미사용 (title/leading 모두 icon-only)"
	},
	"codegen_hint_jsx": [
		"import { TopNavigation, TopNavigationButton, PushBadge } from '@wanteddev/wds';",
		"import { IconSearch, IconBusinessBag } from '@wanteddev/wds-icon';",
		"",
		"export function Header() {",
		"  return (",
		"    <TopNavigation",
		"      variant=\"floating\"",
		"      background",
		"      trailingContent={<>",
		"        <TopNavigationButton variant=\"icon\" color=\"assistive\">",
		"          <IconSearch size={24} />",
		"        </TopNavigationButton>",
		"        <TopNavigationButton variant=\"icon\" color=\"assistive\">",
		"          <IconBusinessBag size={24} />",
		"          <PushBadge>N</PushBadge>",
		"        </TopNavigationButton>",
		"      </>}",
		"    />",
		"  );",
		"}"
	],
	"open_questions": [
		"badge 색상(#3014b8 purple)을 브랜드 컬러로 유지할지, WDS primary(파랑)로 전환할지 결정 필요",
		"cart 아이콘 실제 에셋: WDS IconBusinessBag로 대체? Figma 원본 유지? 커스텀 등록?",
		"TopNavigation variant='floating' vs 'normal' — 스크롤 상단 고정·투명도 요구사항에 따라 선택"
	]
}
