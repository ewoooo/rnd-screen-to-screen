{
	"meta": {
		"purpose": "synthesized atom/link (C8) → WDS TextButton 오버라이드",
		"figma_source": "data/design/components/link.json (synthesized — Figma 미정의)",
		"wds_source": "registry/wds-component-registry.json",
		"notion_code": "C8",
		"fetched_at": "2026-04-24",
		"strategy": "WDS TextButton에 1:1 매핑. href 있으면 anchor as prop, 아니면 button."
	},
	"mapping": {
		"target_component": "text-button",
		"target_import": "import { TextButton } from '@wanteddev/wds';",
		"target_package": "@wanteddev/wds",
		"root": {
			"wds": "TextButton",
			"props": { "color": "primary | assistive", "size": "small | medium" },
			"polymorphic_as": "href 있을 때 'a', 없으면 'button' (WDS PolymorphicComponent 사용)"
		},
		"trailing_icon": {
			"wds": "trailingContent prop",
			"conditional": "trailingIcon = true",
			"icon": "IconChevronRight (16)"
		}
	},
	"token_overrides": {
		"strategy": "TextButton color enum이 자체 토큰 처리 (primary|assistive)",
		"mappings": [
			{ "from_synth": "link/primary", "to_wds": "color='primary'", "confidence": "high" },
			{ "from_synth": "link/assistive", "to_wds": "color='assistive'", "confidence": "high" }
		]
	}
}
