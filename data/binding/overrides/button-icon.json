{
	"meta": {
		"purpose": "Figma button-icon (C2) → WDS IconButton (+PushBadge) 오버라이드",
		"figma_source": "data/design/components/button-icon.json",
		"wds_source": "registry/wds-component-registry.json + registry/wds-icon-registry.json",
		"notion_code": "C2",
		"fetched_at": "2026-04-24",
		"strategy": "Figma는 28×28 컨테이너 + 24×24 아이콘 + 선택적 badge. WDS IconButton(medium)이 32 touch target + 24 아이콘을 내장 제공. 배지는 PushBadge로 children 래핑."
	},
	"mapping": {
		"target_component": "icon-button",
		"target_import": "import { IconButton, PushBadge } from '@wanteddev/wds';",
		"target_package": "@wanteddev/wds",
		"root": {
			"wds": "IconButton",
			"props": { "variant": "normal", "size": "medium", "color": "primary" },
			"from_figma": { "node": "1:26098", "size": "28×28", "icon_size": "24×24", "touch_target": "32×32" },
			"from_figma_drop": ["badge_padding_3_5", "badge_radius_30"],
			"drop_reason": "PushBadge가 자체 크기/패딩/라운드 처리"
		},
		"badge": {
			"wds": "PushBadge",
			"props": { "variant": "number", "count": "N", "position": "top-right" },
			"conditional": "badgeCount !== undefined일 때만 래핑",
			"from_figma": { "ref_node": "badge-label-text (1:26273)", "position": "top-right offset (-3.34, -6)" },
			"tokens_drop": ["badge/label/primary #3014b8", "badge/label/onPrimary #ffffff"],
			"replace_with": "PushBadge 기본 스타일"
		},
		"icon_slot": {
			"wds": "children",
			"default": "IconBusinessBag (24)",
			"note": "C2는 슬롯이므로 컨슈머가 아이콘 주입. Header 사용 사례 기준 cart 대체로 IconBusinessBag default."
		}
	},
	"token_overrides": {
		"strategy": "Figma button/dark(#1a1a1a)는 WDS color='primary'로 위임",
		"mappings": [
			{ "from_figma": "button/dark #1a1a1a", "to_wds": "color='primary'", "confidence": "high" }
		]
	}
}
