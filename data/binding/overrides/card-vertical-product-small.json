{
	"meta": {
		"purpose": "Figma card-vertical-product/small → WDS Card",
		"figma_source": "data/design/components/card-vertical-product-small.json",
		"fetched_at": "2026-04-24",
		"strategy": "WDS Card는 카드 backdrop·border 없는 raw column 컨테이너로 사용. ImgRectanglePilot(size=medium) + button-add absolute overlay + CardContent + ButtonChipPilot. 가격 2행 모두 Typography composite."
	},
	"mapping": {
		"target_import": "import { Card, CardCaption, CardContent, CardTitle, IconButton, Typography } from '@wanteddev/wds';",
		"root": { "wds": "Card", "props": { "platform": "mobile", "flexDirection": "column", "gap": 16, "width": 142, "sx": { "background": "transparent", "boxShadow": "none", "padding": 0 } } },
		"thumbnail_block": { "wds": "div(relative)", "children": [
			{ "wds": "ImgRectanglePilot", "props": { "size": "medium" } },
			{ "wds": "IconButton (absolute)", "props": { "variant": "solid", "size": "small", "sx": { "position": "absolute", "left": 100, "top": 100 } }, "conditional": "showAdd" }
		]},
		"info_block": { "wds": "CardContent", "props": { "flexDirection": "column", "gap": 10 }, "children": [
			{ "wds": "CardCaption", "variant": "caption1", "weight": "medium" },
			{ "wds": "CardTitle", "variant": "body2", "weight": "bold", "maxLines": 2 },
			{ "wds": "Typography", "role": "price-strike", "spans": ["info violet 12 bold", "origin 12 medium #666 line-through 50%"] },
			{ "wds": "Typography", "role": "price-main", "spans": ["info violet 16 bold", "price 14 bold", "month 12 normal"] },
			{ "wds": "div + Typography", "role": "slot-badge" }
		]},
		"button": { "wds": "ButtonChipPilot", "props": { "size": "small", "type": "stoke" } }
	},
	"open_questions": ["button-add를 IconButton.sx position absolute로 우회 — Card 내장 슬롯 정식 패턴 미확인"]
}
