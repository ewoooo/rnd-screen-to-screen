		{
			"from": "nc-full-leave-notice",
			"to": "nc-full-leave-confirm",
			"trigger": "primary_cta",
			"guard": "notice_acknowledged"
		},
		{
			"from": "nc-full-leave-confirm",
			"to": "nc-full-leave-result",
			"trigger": "primary_cta",
			"guard": "final_consent_confirmed AND withdrawal_processed",
			"note": "최종 동의 후 BSS PR-MBR-CS-003-05(탈퇴 처리)가 자동 진행되고 그 결과로 result 화면 진입."
		}
	],
	"branches": [
		{
			"from": "nc-full-leave-confirm",
			"condition": "NOT final_consent_confirmed",
			"behavior": "탈퇴 중단. 이전 화면 또는 마이페이지로 이탈(spec 범위 외)."
		},
		{
			"from": "nc-full-leave-auth",
			"condition": "auth_failed",
			"behavior": "동일 화면 재시도. 재시도 제한 초과 시 안내 후 종료."
		}
	],
	"design_signals": [
