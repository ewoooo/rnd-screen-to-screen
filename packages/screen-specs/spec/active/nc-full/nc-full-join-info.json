{
	"meta": {
		"schema_version": 2,
		"status": "active",
		"route": "/nc-full-join-info",
		"source": "policy-driven",
		"policy_doc": "docs/NC_정책서_Full_v1.0_확정본.md",
		"policy_section": "4.다.2) PR-MBR-CS-001-02",
		"pagination_ref": "packages/screen-specs/spec/active/nc-full/_pagination/nc-full-join.json"
	},
	"screen": {
		"id": "nc-full-join-info",
		"name": "개인정보 입력",
		"domain": "nc-full",
		"use_case": "US-MBR-CS-001",
		"process_id": "PR-MBR-CS-001-02",
		"step_fraction": "2/4",
		"type": "page"
	},
	"x_interfacePlan": {
		"genre": "form",
		"primary_task": "회원 기본 정보 입력 + 형식 검증",
		"info_hierarchy": [
			"hero (가입 2/4 맥락)",
			"required-input (이름·생년월일·성별·휴대전화·이메일)",
			"action (다음으로)"
		],
		"cta_location": "bottom-sticky",
		"progress_location": "top-bar-thin",
		"sectioning": "flat",
		"copy_policy": {
			"description_measure": "body",
			"avoid_full_width_caption": true
		},
		"rail_policy": {
			"owner": "ContentRail",
			"route_margin": "forbidden"
		}
	},
	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": {
				"owner": "NcShell",
				"patterns": ["NcTopBar"],
				"flow": "reserved"
			},
			"content": {
				"owner": "ContentList",
				"patterns": ["NcHero", "NcPersonalInfoForm"]
			},
			"bottom": {
				"owner": "NcShell",
				"patterns": ["NcContinueBar"],
				"flow": "reserved"
			}
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "top-progress",
			"slot": "top",
			"pattern": "organisms/nc/NcTopBar",
			"uses": ["StatusBar", "TopNavigation", "ProgressIndicator"],
			"layout": {
				"flow": "reserved",
				"progress_source": "data.flow.progress",
				"leading": "back"
			},
			"content_role": "flow-progress"
		},
		{
			"id": "hero",
			"slot": "content",
			"pattern": "organisms/nc/NcHero",
			"uses": ["ContentSection", "TextBlock", "ContentRail"],
			"layout": {
				"section_inset": "inherit",
				"description_rail": "measure:body",
				"block_padding_top": "spacing-16",
				"block_padding_bottom": "spacing-32"
			},
			"content_role": "primary-copy"
		},
		{
			"id": "form",
			"slot": "content",
			"pattern": "organisms/nc/NcPersonalInfoForm",
			"uses": ["ContentSection", "FormField", "TextField", "Select", "TextBlock"],
			"layout": {
				"section_inset": "inherit",
				"field_gap": "spacing-12"
			},
			"content_role": "required-input",
			"state_binding": {
				"field_required": ["name", "birthDate", "gender", "phone"],
				"field_optional": ["email"],
				"validation_owner": "FormField (errorText)"
			}
		},
		{
			"id": "continue",
			"slot": "bottom",
			"pattern": "organisms/nc/NcContinueBar",
			"uses": ["Box", "Button", "TextBlock"],
			"content_role": "primary-action",
			"layout": { "surface": "page-semi-gradient" },
			"state_binding": {
				"primary_disabled_when": "form.invalidCount > 0 OR form.missingRequiredCount > 0",
				"eyebrow_when_blocked": "필수 항목을 입력해 주세요",
				"eyebrow_when_ready": "data.continue.eyebrow"
			}
		}
	],
	"design_system_contract": {
		"templates": [
			"AppScreen",
			"AppScreenContent",
			"ContentOutlet",
			"ContentList",
			"ContentSection"
		],
		"organisms": ["nc"],
		"molecules": ["FormField", "form-controls (TextField, Select)", "ProgressIndicator"],
		"atoms": ["TextBlock"],
		"allowed_escape_hatches": [],
		"new_vocabulary_required": ["organisms/nc/NcPersonalInfoForm"]
	}
}
