{
	"meta": {
		"schema_version": 2,
		"status": "active",
		"route": "/membership-leave-complete",
		"source": "implemented-page"
	},
	"screen": {
		"id": "membership-leave-complete",
		"name": "탈퇴 결과 안내",
		"domain": "membership",
		"type": "page"
	},
	"x_interfacePlan": {
		"genre": "result",
		"primary_task": "탈퇴 처리 결과 + 유예 기간/철회 안내",
		"info_hierarchy": [
			"hero (완료 + 유예 안내)",
			"result-summary (처리 정보)",
			"supporting-notice (철회 방법)",
			"actions (홈 / 철회)"
		],
		"cta_location": "bottom-sticky",
		"progress_location": "top-bar-thin",
		"sectioning": "one-card",
		"copy_policy": { "description_measure": "body" },
		"rail_policy": { "description": "measure:body", "notice": "measure:body" }
	},
	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": { "owner": "MembershipShell", "patterns": ["MembershipTopBar"], "flow": "reserved" },
			"content": { "owner": "ContentList", "patterns": ["MembershipHero", "MembershipSummaryCard", "MembershipNotice"] },
			"bottom": { "owner": "MembershipShell", "patterns": ["MembershipResultActions"], "flow": "reserved" }
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "hero",
			"slot": "content",
			"pattern": "organisms/membership/MembershipHero",
			"uses": ["ContentSection", "TextBlock", "ContentRail"],
			"layout": { "section_inset": "inherit", "description_rail": "measure:body" },
			"content_role": "primary-copy"
		},
		{
			"id": "summary",
			"slot": "content",
			"pattern": "organisms/membership/MembershipSummaryCard",
			"uses": ["ContentSection", "SectionCard", "InfoList"],
			"layout": { "section_inset": "inherit", "trailing_semantic": "status" },
			"content_role": "result-summary"
		},
		{
			"id": "withdrawal-notice",
			"slot": "content",
			"pattern": "organisms/membership/MembershipNotice",
			"uses": ["ContentSection", "NoticeBlock", "TextBlock", "ContentRail"],
			"layout": { "section_inset": "inherit", "text_rail": "measure:body" },
			"content_role": "supporting-notice"
		},
		{
			"id": "actions",
			"slot": "bottom",
			"pattern": "organisms/membership/MembershipResultActions",
			"uses": ["PrimaryCTABar", "Button"],
			"content_role": "primary-action",
			"layout": { "surface": "page-semi-gradient" }
		}
	],
	"design_system_contract": {
		"templates": ["AppScreen", "AppScreenContent", "ContentOutlet", "ContentList", "ContentSection", "ContentRail"],
		"organisms": ["membership"],
		"molecules": ["InfoList", "NoticeBlock", "PrimaryCTABar", "SectionCard"],
		"atoms": ["TextBlock"],
		"allowed_escape_hatches": [
			{
				"location": "molecules/info-list/InfoList.tsx",
				"kind": "raw-border",
				"value": "borderBottom: 1px solid var(--semantic-line-solid-alternative)",
				"reason": "row separator. WDS Divider 흡수 후보",
				"owner": "molecule"
			}
		],
		"new_vocabulary_required": []
	}
}
