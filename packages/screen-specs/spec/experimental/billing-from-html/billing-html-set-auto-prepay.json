			"selectable (대상)",
			"supporting (적용 시점/미지원)",
			"action"
		],
		"cta_location": "bottom-sticky",
		"progress_location": "none",
		"sectioning": "flat",
		"copy_policy": {
			"description_measure": "body",
			"avoid_full_width_caption": true
		},
