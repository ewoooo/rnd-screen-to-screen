		"slots": {
			"top": {
				"owner": "GlobalNavigationHeader",
				"patterns": [
					"TopNavigation"
				],
				"flow": "reserved"
			},
			"content": {
				"owner": "ContentList",
				"patterns": [
					"Hero",
					"EnableSwitch",
					"ThresholdField",
					"TargetSelectableList",
					"EffectiveNotice"
				]
			},
			"bottom": {
				"owner": "StickyActionBar",
				"patterns": [
					"PrimaryCTA"
				],
				"flow": "reserved"
			}
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "top",
			"slot": "top",
			"pattern": "organisms/global/GlobalNavigationHeader",
			"uses": [
				"TopNavigation"
			],
			"layout": {
				"leading": "back",
				"title": "자동 선결제"
			},
			"content_role": "navigation"
		},
		{
			"id": "hero",
			"slot": "content",
			"pattern": "molecules/Hero",
			"uses": [
				"ContentSection",
				"TextBlock",
				"ContentRail"
			],
			"layout": {
				"section_inset": "inherit"
			},
			"content_role": "primary-copy"
		},
		{
			"id": "enable",
			"slot": "content",
			"pattern": "molecules/FormField",
			"uses": [
				"ContentSection",
				"FormField",
				"Switch"
			],
			"layout": {
				"section_inset": "inherit",
				"layout": "row-trailing"
			},
			"content_role": "required-input"
		},
		{
			"id": "threshold",
			"slot": "content",
			"pattern": "molecules/FormField",
			"uses": [
				"ContentSection",
				"FormField",
				"TextField"
			],
			"layout": {
				"section_inset": "inherit"
			},
			"content_role": "required-input",
			"state_binding": {
				"visible_when": "enable = true",
				"field_required": [
					"threshold"
				],
				"validation_owner": "FormField (errorText)"
			}
		},
		{
			"id": "target",
			"slot": "content",
			"pattern": "molecules/SelectableList",
			"uses": [
				"ContentSection",
				"SelectableList"
			],
			"layout": {
				"section_inset": "inherit",
				"selectionMode": "multi"
			},
			"content_role": "required-input",
			"state_binding": {
				"visible_when": "enable = true",
				"field_required": [
					"targets"
				]
			}
		},
		{
			"id": "effective",
			"slot": "content",
			"pattern": "molecules/NoticeBlock",
			"uses": [
				"ContentSection",
				"NoticeBlock"
			],
			"layout": {
				"section_inset": "inherit"
			},
			"content_role": "supporting-notice"
		},
		{
			"id": "continue",
			"slot": "bottom",
			"pattern": "molecules/StickyActionBar",
			"uses": [
				"Box",
				"Button",
				"TextBlock"
			],
			"content_role": "primary-action",
			"state_binding": {
				"primary_disabled_when": "enable = true AND (form.invalidCount > 0 OR form.missingRequiredCount > 0)",
				"eyebrow_when_blocked": "임계 금액과 대상을 선택해 주세요",
				"eyebrow_when_ready": "변경 시 적용 시점은 안내를 따릅니다"
			}
		}
	],
