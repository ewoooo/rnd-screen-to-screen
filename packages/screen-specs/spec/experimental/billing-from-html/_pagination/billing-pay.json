		},
		{
			"from": "billing-pay-method-auth",
			"to": "billing-pay-confirm",
			"trigger": "system",
			"guard": "auth_succeeded AND consent_passed"
		},
		{
			"from": "billing-pay-method-auth",
			"to": "billing-pay-method",
			"trigger": "system",
			"guard": "auth_failed",
			"note": "동일 화면에서 재시도 또는 method 재선택"
		},
		{
			"from": "billing-pay-third-party-consent",
			"to": "billing-pay-confirm",
			"trigger": "system",
			"guard": "consent_granted"
		},
		{
			"from": "billing-pay-confirm",
			"to": "billing-pay-result",
			"trigger": "primary_cta",
			"guard": "approval_request_submitted"
		},
		{
			"from": "billing-pay-result",
			"to": "billing-pay-failure",
			"trigger": "system",
			"guard": "result IN (failed, pending_long, duplicate)"
		},
		{
			"from": "billing-pay-schedule",
			"to": "billing-pay-schedule-result",
			"trigger": "primary_cta",
			"guard": "schedule_request_submitted"
		},
		{
			"from": "billing-pay-proxy",
			"to": "billing-pay-proxy-execute",
			"trigger": "primary_cta",
			"guard": "proxy_eligible AND auth_passed"
		},
		{
			"from": "billing-pay-proxy-execute",
			"to": "billing-pay-proxy-result",
			"trigger": "primary_cta",
			"guard": "proxy_payment_request_submitted"
		},
		{
			"from": "billing-pay-prepay",
			"to": "billing-pay-prepay-result",
			"trigger": "primary_cta",
			"guard": "prepay_request_submitted"
		},
		{
			"from": "billing-pay-failure",
			"to": "billing-pay-confirm",
			"trigger": "primary_cta",
			"guard": "user_chooses_retry"
		},
		{
			"from": "billing-pay-failure",
			"to": "billing-pay-method",
			"trigger": "secondary_cta",
			"guard": "user_chooses_alternate_method"
		}
	]
