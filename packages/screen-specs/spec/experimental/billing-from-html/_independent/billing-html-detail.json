{
	"meta": {
		"schema_version": 2,
		"status": "experimental-html-independent",
		"route": "/billing-html-detail",
		"source": "policy",
		"source_ref": "docs/정책서-Full-청구관리및요금수납_정책서.html#PR-BIL-CHK-002"
	},
	"screen": {
		"id": "billing-html-detail",
		"name": "청구 상세 및 변동 사유",
		"domain": "billing-html",
		"type": "page"
	},
	"x_interfacePlan": {
		"genre": "detail",
		"primary_task": "항목별 금액과 변동 사유를 이해하고 필요 시 문의/운영 확인",
		"info_hierarchy": [
			"context-summary",
			"primary-list (항목)",
			"explanation-list (변동 사유)",
			"follow-up-action",
			"supporting-notice"
		],
		"cta_location": "inline",
		"progress_location": "none",
		"sectioning": "multi-card",
		"copy_policy": {
			"amount_emphasis": "displayTitle",
			"avoid_full_width_caption": true
		},
		"rail_policy": {
			"owner": "ContentRail",
			"route_margin": "forbidden"
		}
	},
	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": {
				"owner": "GlobalNavigationHeader",
				"patterns": ["GlobalNavigationHeader"],
				"flow": "reserved"
			},
			"content": {
				"owner": "ContentList",
				"patterns": [
					"BillingDetailHeader",
					"BillingItemBreakdown",
					"BillingChangeReasonList",
					"BillingInquiryActions",
					"NoticeBlock"
				]
			}
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "context",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingDetailHeader",
			"uses": ["ContentSection", "TextBlock", "ContentRail"],
			"layout": {
				"section_inset": "inherit",
				"amount_emphasis": "displayTitle",
				"description_rail": "measure:body"
			},
			"content_role": "context-summary"
		},
		{
			"id": "items",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingItemBreakdown",
			"uses": ["ContentSection", "SectionCard", "InfoList", "TextBlock"],
			"layout": {
				"section_inset": "inherit",
				"trailing_semantic": "value"
			},
			"content_role": "primary-list"
		},
		{
			"id": "change-reasons",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingChangeReasonList",
			"uses": ["ContentSection", "SectionCard", "InfoList", "TextBlock", "ContentBadge"],
			"layout": {
				"section_inset": "inherit",
				"trailing_semantic": "value",
				"value_tone": "delta"
			},
			"content_role": "explanation-list"
		},
		{
			"id": "inquiry",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingInquiryActions",
			"uses": ["ContentSection", "SectionCard", "Button", "TextBlock"],
			"layout": {
				"section_inset": "inherit",
				"button_layout": "inline-pair"
			},
			"content_role": "follow-up-action"
		},
		{
			"id": "notice",
			"slot": "content",
			"pattern": "molecules/notice-block/NoticeBlock",
			"uses": ["ContentSection", "NoticeBlock", "TextBlock"],
			"layout": {
				"section_inset": "inherit"
			},
			"content_role": "supporting-notice"
		}
	],
	"design_system_contract": {
		"templates": [
			"AppScreen",
			"AppScreenContent",
			"ContentOutlet",
			"ContentList",
			"ContentSection",
			"ContentRail"
		],
		"organisms": ["billing-html", "global"],
		"molecules": ["SectionCard", "InfoList", "NoticeBlock"],
		"atoms": ["TextBlock"],
		"allowed_escape_hatches": [],
		"new_vocabulary_required": [
			"organisms/billing-html (BillingDetailHeader, BillingItemBreakdown, BillingChangeReasonList, BillingInquiryActions)"
		]
	}
}
