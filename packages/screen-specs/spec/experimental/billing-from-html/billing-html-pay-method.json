{
	"meta": {
		"schema_version": 2,
		"status": "experimental-html",
		"route": "/billing-html-pay-method",
		"source": "policy-driven",
		"policy_doc": "docs/정책서-Full-청구관리및요금수납_정책서.html",
		"policy_section": "4. US-BIL-PAY-001 / PR-BIL-PAY-001-01,03",
		"pagination_ref": "packages/screen-specs/spec/experimental/billing-from-html/_pagination/billing-html-pay.json"
	},
	"screen": {
		"id": "billing-html-pay-method",
		"name": "납부수단 선택",
		"domain": "billing-html",
		"use_case": "US-BIL-PAY-001",
		"process_id": "PR-BIL-PAY-001-01,03",
		"step_fraction": "1/8",
		"type": "page"
	},
	"x_interfacePlan": {
		"genre": "selector",
		"primary_task": "납부수단 단일 선택 + 납부 가능 최종 확인",
		"info_hierarchy": [
			"hero",
			"target-summary",
			"selector (단일 선택)",
			"action (선택)"
		],
		"cta_location": "bottom-sticky",
		"progress_location": "top-bar-thin",
		"sectioning": "flat",
		"copy_policy": {
			"description_measure": "body",
			"avoid_full_width_caption": true
		},
		"rail_policy": {
			"owner": "ContentRail",
			"route_margin": "forbidden"
		}
	},
	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": {
				"owner": "GlobalNavigationHeader",
				"patterns": [
					"GlobalNavigationHeader"
				],
				"flow": "reserved"
			},
			"content": {
				"owner": "ContentList",
				"patterns": [
					"ContentSection",
					"TextBlock",
					"SummaryCard",
					"SelectableList"
				]
			},
			"bottom": {
				"owner": "StickyActionBar",
				"patterns": [
					"StickyActionBar"
				],
				"flow": "reserved"
			}
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "top-progress",
			"slot": "top",
			"pattern": "organisms/global/GlobalNavigationHeader",
			"uses": [
				"TopNavigation",
				"ProgressIndicator"
			],
			"layout": {
				"flow": "reserved",
				"progress_source": "data.flow.progress",
				"leading": "back"
			},
			"content_role": "flow-progress"
		},
		{
			"id": "hero",
			"slot": "content",
			"pattern": "ContentSection + TextBlock",
			"uses": [
				"ContentSection",
				"ContentRail",
				"TextBlock"
			],
			"layout": {
				"section_inset": "inherit",
				"description_rail": "measure:body"
			},
			"content_role": "primary-copy"
		},
		{
			"id": "target",
			"slot": "content",
			"pattern": "molecules/SummaryCard",
			"uses": [
				"ContentSection",
				"SummaryCard"
			],
			"content_role": "context-summary"
		},
		{
			"id": "methods",
			"slot": "content",
			"pattern": "molecules/SelectableList",
			"uses": [
				"ContentSection",
				"SelectableList",
				"TextBlock"
			],
			"layout": {
				"section_inset": "inherit",
				"selectionMode": "single",
				"trailing_semantic": "status"
			},
			"content_role": "primary-choice"
		},
		{
			"id": "continue",
			"slot": "bottom",
			"pattern": "molecules/StickyActionBar",
			"uses": [
				"Box",
				"Button",
				"TextBlock"
			],
			"content_role": "primary-action",
			"state_binding": {
				"primary_disabled_when": "methods.selected == null",
				"eyebrow_when_ready": "data.continue.eyebrow"
			}
		}
	],
	"design_system_contract": {
		"templates": [
			"AppScreen",
			"AppScreenContent",
			"ContentOutlet",
			"ContentList",
			"ContentSection",
			"ContentRail"
		],
		"organisms": [
			"global"
		],
		"molecules": [
			"SummaryCard",
			"SelectableList",
			"StickyActionBar"
		],
		"atoms": [
			"TextBlock"
		],
		"allowed_escape_hatches": [],
		"new_vocabulary_required": []
	}
}