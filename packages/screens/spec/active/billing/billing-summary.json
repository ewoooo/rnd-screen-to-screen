	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": { "owner": "GlobalNavigationHeader", "patterns": ["GlobalNavigationHeader"], "flow": "reserved" },
			"content": { "owner": "ContentList", "patterns": ["SummaryCard", "InfoList", "NoticeBlock"] },
			"bottom": { "owner": "PrimaryCTABar", "patterns": ["PrimaryCTABar"], "flow": "reserved" }
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "top",
			"slot": "top",
			"pattern": "organisms/global/GlobalNavigationHeader",
			"uses": ["GlobalNavigationHeader"],
			"layout": { "leading": "back", "title": "청구 요약" },
			"content_role": "chrome"
		},
		{
			"id": "summary",
			"slot": "content",
			"pattern": "molecules/SummaryCard",
			"uses": ["SummaryCard", "TextBlock"],
			"layout": { "section_inset": "inherit" },
			"content_role": "primary-summary"
		},
		{
			"id": "details",
			"slot": "content",
			"pattern": "molecules/InfoList",
			"uses": ["InfoList"],
			"layout": { "section_inset": "inherit", "trailing_semantic": "value" },
			"content_role": "supporting-list",
			"state_binding": { "rows": ["자동납부 예정", "회선 청구액"] }
		},
		{
			"id": "restriction-notice",
			"slot": "content",
			"pattern": "molecules/NoticeBlock",
			"uses": ["NoticeBlock"],
			"layout": { "section_inset": "inherit" },
			"content_role": "supporting-notice",
			"state_binding": { "visible_when": "claim_state IN (수납대기, 납부제한)" }
		},
		{
			"id": "cta",
			"slot": "bottom",
			"pattern": "molecules/PrimaryCTABar",
			"uses": ["PrimaryCTABar", "Button"],
			"layout": { "surface": "page-semi-gradient" },
			"content_role": "primary-action",
			"state_binding": { "primary_disabled_when": "claim_state IN (수납대기, 수납완료, 납부제한)" }
		}
	],
	"design_system_contract": {
		"templates": ["AppScreen", "AppScreenContent", "ContentOutlet", "ContentList", "ContentSection"],
		"organisms": ["global"],
		"molecules": ["SummaryCard", "InfoList", "NoticeBlock", "PrimaryCTABar"],
		"atoms": ["TextBlock"],
