{
	"meta": {
		"schema_version": 2,
		"status": "experimental-html-independent",
		"route": "/billing-html-summary",
		"source": "policy",
		"source_ref": "docs/정책서-Full-청구관리및요금수납_정책서.html#PR-BIL-CHK-001"
	},
	"screen": {
		"id": "billing-html-summary",
		"name": "청구 요약 확인",
		"domain": "billing-html",
		"type": "page"
	},
	"x_interfacePlan": {
		"genre": "browse",
		"primary_task": "당월 청구 요약을 보고 다음 행동을 결정",
		"info_hierarchy": [
			"context (조회 회선)",
			"primary-summary (당월 금액·기한·상태)",
			"navigation (다음 행동)",
			"supporting-notice"
		],
		"cta_location": "inline",
		"progress_location": "none",
		"sectioning": "multi-card",
		"copy_policy": {
			"amount_emphasis": "displayTitle",
			"meta_truncate": true,
			"avoid_full_width_caption": true
		},
		"rail_policy": {
			"owner": "ContentRail",
			"route_margin": "forbidden"
		}
	},
	"screen_contract": {
		"shell": "AppScreen",
		"slots": {
			"top": {
				"owner": "GlobalNavigationHeader",
				"patterns": ["GlobalNavigationHeader"],
				"flow": "reserved"
			},
			"content": {
				"owner": "ContentList",
				"patterns": [
					"BillingLineSelector",
					"BillingSummaryCard",
					"BillingNextActions",
					"NoticeBlock"
				]
			},
			"bottom": {
				"owner": "GlobalNavigationBar",
				"patterns": ["GlobalNavigationBar"],
				"flow": "reserved"
			}
		}
	},
	"layout_contract": {
		"content_outlet_inline_inset": "spacing-12",
		"section_inset": "inherit",
		"content_gap": "spacing-4",
		"content_gap_owner": "ContentList",
		"top_bottom_flow": "reserved",
		"bleed_sections": [],
		"content_rail_owner": "ContentRail"
	},
	"areas": [
		{
			"id": "line-selector",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingLineSelector",
			"uses": ["ContentSection", "SectionCard", "InfoList", "TextBlock"],
			"layout": {
				"section_inset": "inherit",
				"trailing_semantic": "action"
			},
			"content_role": "context-selector"
		},
		{
			"id": "summary",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingSummaryCard",
			"uses": ["ContentSection", "SummaryCard", "TextBlock", "ContentBadge"],
			"layout": {
				"section_inset": "inherit",
				"amount_emphasis": "displayTitle",
				"badge_position": "trailing"
			},
			"content_role": "primary-summary"
		},
		{
			"id": "next-actions",
			"slot": "content",
			"pattern": "organisms/billing-html/BillingNextActions",
			"uses": ["ContentSection", "SectionCard", "InfoList", "TextBlock"],
			"layout": {
				"section_inset": "inherit",
				"trailing_semantic": "action"
			},
			"content_role": "navigation-list"
		},
		{
			"id": "notice",
			"slot": "content",
			"pattern": "molecules/notice-block/NoticeBlock",
			"uses": ["ContentSection", "NoticeBlock", "TextBlock"],
			"layout": {
				"section_inset": "inherit"
			},
			"content_role": "supporting-notice"
		}
	],
	"design_system_contract": {
		"templates": [
			"AppScreen",
			"AppScreenContent",
			"ContentOutlet",
			"ContentList",
			"ContentSection"
		],
		"organisms": ["billing-html", "global"],
		"molecules": ["SectionCard", "SummaryCard", "InfoList", "NoticeBlock"],
		"atoms": ["TextBlock"],
		"allowed_escape_hatches": [],
		"new_vocabulary_required": [
			"organisms/billing-html (BillingLineSelector, BillingSummaryCard, BillingNextActions)"
		]
	}
}
