	"transitions": [
		{
			"from": "billing-html-summary",
			"to": "billing-html-detail",
			"trigger": "primary_cta",
			"guard": "user_taps_view_detail"
		},
		{
			"from": "billing-html-summary",
			"to": "billing-html-target-select",
			"trigger": "primary_cta",
			"guard": "next_action=pay_now OR pay_arrears"
		},
		{
			"from": "billing-html-summary",
			"to": "billing-html-arrears-status",
			"trigger": "primary_cta",
			"guard": "next_action=verify_arrears_resolution"
		},
		{
			"from": "billing-html-detail",
			"to": "billing-html-realtime",
			"trigger": "secondary_cta",
			"guard": "view_realtime_or_forecast"
		},
		{
			"from": "billing-html-realtime",
			"to": "billing-html-msc-history",
			"trigger": "inline_link",
			"guard": "msc_or_content_charges_present"
		},
		{
			"from": "billing-html-realtime",
			"to": "billing-html-set-msc-limit",
			"trigger": "inline_link",
			"guard": "user_chooses_change_limit",
			"note": "cross_flow:billing-set"
		},
		{
			"from": "billing-html-realtime",
			"to": "billing-html-pay-prepay",
			"trigger": "inline_link",
			"guard": "user_chooses_prepay",
			"note": "cross_flow:billing-pay"
		},
		{
			"from": "billing-html-msc-history",
			"to": "billing-html-pay-prepay",
			"trigger": "row_action",
			"guard": "prepay_eligible",
			"note": "cross_flow:billing-pay"
		},
		{
			"from": "billing-html-msc-history",
			"to": "billing-html-set-msc-limit",
			"trigger": "footer_cta",
			"guard": "user_chooses_change_limit",
			"note": "cross_flow:billing-set"
		},
		{
			"from": "billing-html-statement",
			"to": "billing-html-statement-result",
			"trigger": "system",
			"guard": "reissue_request_submitted"
		},
		{
			"from": "billing-html-target-select",
			"to": "billing-html-pay-method",
			"trigger": "primary_cta",
			"guard": "target_amount_confirmed",
			"note": "cross_flow:billing-pay"
		},
		{
			"from": "billing-html-payment-history",
			"to": "billing-html-receipt-result",
			"trigger": "system",
			"guard": "receipt_reissue_request_submitted"
		},
		{
			"from": "billing-html-arrears-status",
			"to": "billing-html-pay-method",
			"trigger": "primary_cta",
			"guard": "arrears_remaining AND user_chooses_pay",
			"note": "cross_flow:billing-pay"
		}
	],
	"branches": [
		{
			"from": "billing-summary",
			"condition": "claim_state IN (수납대기, 납부제한)",
			"behavior": "납부 CTA 비활성, 사유 안내(POL-BIL-CUS-001-03). 수납대기는 결과 확인, 제한은 사유 확인으로 분기."
		},
		{
			"from": "billing-statement",
			"condition": "재발행 권한 부재 OR 보관기간 초과",
			"behavior": "재발행 불가 안내 + 상담 전환(POL-BIL-CUS-001-09)"
		},
		{
			"from": "billing-arrears-status",
			"condition": "정지 해제 미반영 OR 추가 조치 필요",
			"behavior": "재처리 요청 또는 상담 이관 안내 (운영자 OP-003 flow로 진입은 BO 범위 외)"
		}
	],
	"design_signals": [
		"CHK 도메인은 read-first browse 흐름. 8 UC 모두 단일 primary task 중심, 다음 행동은 footer CTA 또는 row inline action.",
		"CHK-005, CHK-007의 재발행은 인증·연계 처리가 비동기 — result 화면을 별도로 두어 발급 유형·수신처·재발행 가능 여부를 명시.",
		"CHK-006은 selector 장르 — 청구 대상 list + 금액 합계 + bottom CTA.",
		"CHK 화면들은 다른 flow(PAY, SET, 상담)로의 진입 hub. transitions에 cross-flow 도착점을 명시."
	]
}