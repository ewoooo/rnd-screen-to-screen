{
  "name": "rnd-screen-to-screen",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev -w @screen/mobile",
    "dev:preview": "npm run dev -w @screen/preview",
    "dev:storybook": "npm run dev -w @screen/storybook",
    "build:mobile": "npm run build -w @screen/mobile",
    "build:preview": "npm run build -w @screen/preview",
    "build:storybook": "npm run build -w @screen/storybook",
    "chromatic:storybook": "npm run chromatic -w @screen/storybook",
    "lint:mobile": "npm run lint -w @screen/mobile",
    "lint:preview": "npm run lint -w @screen/preview"
  }
}
