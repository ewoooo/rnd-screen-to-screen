{
  "name": "pxdx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n mobile,preview -c cyan,magenta \"npm:dev:mobile\" \"npm:dev:preview\"",
    "dev:mobile": "npm run dev -w @screen/mobile",
    "dev:preview": "npm run dev -w @screen/preview",
    "build:mobile": "npm run build -w @screen/mobile",
    "build:preview": "npm run build -w @screen/preview",
    "doctor": "react-doctor . --yes",
    "doctor:verbose": "react-doctor . --yes --verbose",
    "lint": "npm run lint:mobile && npm run lint:preview",
    "lint:mobile": "npm run lint -w @screen/mobile",
    "lint:preview": "npm run lint -w @screen/preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "concurrently": "^9.2.1",
    "react-doctor": "^0.0.47"
  }
}
